# --- Meta (Facebook) app ---
# App Dashboard -> Settings -> Basic -> App Secret
META_APP_SECRET=
# Any random string you choose; must match what you enter in the Meta
# webhook subscription setup ("Verify Token" field)
META_VERIFY_TOKEN=
# Page access token for the Page running the ads (prefer a long-lived
# System User token from Business Manager so it doesn't expire every 60 days)
META_PAGE_ACCESS_TOKEN=
META_GRAPH_API_VERSION=v21.0

# --- Odoo ---
ODOO_URL=https://your-instance.odoo.com
ODOO_DB=your-db-name
# API user should be a dedicated service account with just CRM lead-create rights
ODOO_USERNAME=meta-integration@yourcompany.com
ODOO_API_KEY=

# --- Service ---
# Where the SQLite idempotency store and dead-letter file are written
DATA_DIR=./data
FIELD_MAPPING_PATH=./config/field_mapping.yaml
PORT=8000
